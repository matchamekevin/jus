# ============================================================
# JusTogo — Configuration de production
# Copier ce fichier en .env.production et adapter les valeurs
# ============================================================

# Domaine du site (sans https://)
DOMAIN=justogo.com

# URL complète du site
APP_URL=https://justogo.com

# Email pour les certificats SSL (Let's Encrypt)
SSL_EMAIL=admin@justogo.com

# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_USER=jus_user
POSTGRES_PASSWORD=CHANGEZ_MOI_MOT_DE_PASSE_TRES_FORT_2026
POSTGRES_DB=jus_db

# ── Backend ─────────────────────────────────────────────────
# Clé d'API admin — générer avec : openssl rand -hex 32
ADMIN_API_KEY=CHANGEZ_MOI_CLE_ADMIN_GENEREE

# Port interne (ne pas changer sauf raison)
PORT=4000
NODE_ENV=production
