# Configuration Backend - Jus Locaux Togo

# Environment
NODE_ENV=development

# Port du serveur backend
PORT=4000

# Clé secrète JWT (générer avec: openssl rand -hex 32)
JWT_SECRET=generer_une_cle_forte_ici

# Clé API pour l'administration (générer avec: openssl rand -hex 32)
ADMIN_API_KEY=generer_une_cle_admin_forte_ici

# Database PostgreSQL
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://jus:jus_password@localhost:5432/jus_db

# Configuration PayGate Global (Mobile Money - TMoney/Flooz)
PAYGATE_MEMBER_ID=votre_member_id_paygate
PAYGATE_SECRET_KEY=votre_secret_key_paygate
PAYGATE_ENDPOINT=https://docs.globalpaygate.com/transaction/Checkout
PAYGATE_REDIRECT_URL=http://localhost:5173/confirmation
PAYGATE_NOTIFICATION_URL=http://localhost:4000/api/payments/callback

# Autre fournisseur de paiement (optionnel)
PAYMENT_PROVIDER_KEY=remplacer_si_necessaire
PAYMENT_PROVIDER_CALLBACK_URL=http://localhost:4000/api/payments/callback

